# ReadQuest configuration.
#
# Copy to .env and fill in. .env is gitignored; this file is not — so never
# put real credentials here.
#
#   cp .env.example .env

# --- PostgreSQL (ClickHouse Cloud > your Postgres instance > Connect) -------
# Standard libpq DSN. ClickHouse Cloud requires TLS, hence sslmode=require.
POSTGRES_DSN=postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# --- ClickHouse (ClickHouse Cloud > your CH service > Connect) --------------
# The driver picks its protocol from the URL scheme:
#   https://       -> HTTP protocol,   port 8443
#   clickhouse://  -> native protocol, port 9440
#
# HTTPS is the default here deliberately. Native is marginally faster, but that
# only shows on bulk inserts of millions of rows — ReadQuest writes one row per
# reading session. What does matter is that 9440 is a non-standard port and is
# the kind of thing a conference or corporate network blocks; 8443 gets through
# almost anywhere. HTTPS is also curl-able, which makes a bad connection much
# faster to diagnose.
#
# secure=true is required with EITHER scheme. It is read only from this query
# parameter, never inferred, so https:// without it fails with
# "https without TLS".
CLICKHOUSE_DSN=https://USER:PASSWORD@HOST:8443/default?secure=true

# Native alternative, if you would rather use it and 9440 is reachable:
# CLICKHOUSE_DSN=clickhouse://USER:PASSWORD@HOST:9440/default?secure=true

# --- Claude API (Phase 7: book recommendations) -----------------------------
ANTHROPIC_API_KEY=

# --- MCP server (Phase 6) ---------------------------------------------------
# Shared secret. LibreChat sends this as the X-API-Key header; generate any
# random string, e.g.  openssl rand -hex 24
READQUEST_API_KEY=

# Address the MCP server listens on. ngrok tunnels to this port.
LISTEN_ADDR=:8080
